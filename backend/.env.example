NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Local PostgreSQL. On Render, use the Supabase Session Pooler URL with sslmode=require.
DATABASE_URL=postgresql://studymate:studymate_dev@127.0.0.1:5432/studymate
DB_POOL_MAX=5

# Leave both blank locally to use ./uploads. Set both on Render to use private Supabase Storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=study-documents

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_LIMIT_REVIEWER=3
AI_LIMIT_SUMMARY=3
AI_LIMIT_TOPICS=3
AI_LIMIT_FLASHCARDS=3
AI_LIMIT_QUIZ=5
AI_LIMIT_EXAM=2
AI_LIMIT_TUTOR=20
AI_MAX_CONTEXT_CHARS=60000

UPLOAD_LIMIT_DAILY=5
MAX_FILE_SIZE_MB=20
MAX_DOCUMENT_PAGES=200
UPLOAD_DIR=uploads
TOPIC_STRONG_MIN=80
TOPIC_GOOD_MIN=60
TOPIC_NEEDS_REVIEW_MIN=40
